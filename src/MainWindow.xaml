<Window x:Class="RamAfk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RAM AFK" Height="610" Width="850" Background="#090B10" Foreground="#F5F7FA" WindowStartupLocation="CenterScreen">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="AFK guard" FontSize="25" FontWeight="SemiBold"/><TextBlock Grid.Row="0" Text="Keep managed clients alive with guarded foreground automation; focus may switch briefly." Foreground="#929AAD" Margin="0,35,0,18"/><Border Grid.Row="1" Background="#11141B" BorderBrush="#272D3A" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14"><StackPanel Orientation="Horizontal"><TextBlock Text="Threshold" VerticalAlignment="Center" Foreground="#929AAD"/><TextBlock Text="17 minutes + jitter" Margin="12,0,0,0" VerticalAlignment="Center"/><Button Content="Enable selected" Click="Enable_Click" Margin="20,0,0,0" Background="#7C5CFC" Foreground="White" Padding="14,7"/><Button Content="Pause all" Click="Pause_Click" Margin="8,0,0,0" Background="#1D2230" Foreground="#F5F7FA" Padding="14,7"/></StackPanel></Border><Border Grid.Row="2" Background="#11141B" BorderBrush="#272D3A" BorderThickness="1" CornerRadius="12" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="ACCOUNT HEALTH" Foreground="#929AAD" FontSize="11"/><ListBox x:Name="AccountList" Grid.Row="1" Margin="0,10,0,0" Background="#171B24" Foreground="#F5F7FA" BorderBrush="#272D3A"/><StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="LIVE DIAGNOSTICS" Foreground="#929AAD" FontSize="11"/><ListBox x:Name="DiagnosticsList" Margin="0,8,0,0" MaxHeight="132" Background="#171B24" Foreground="#F5F7FA" BorderBrush="#272D3A"/></StackPanel></Grid></Border><TextBlock Grid.Row="3" x:Name="StatusText" Text="Foreground automation may switch focus briefly and restore the prior client when safe." Foreground="#929AAD" Margin="0,14,0,0"/></Grid>
</Window>
