<Window x:Class="RamAfk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RAM AFK" Height="610" Width="850" Background="#090B10" Foreground="#F5F7FA" WindowStartupLocation="CenterScreen">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="AFK guard" FontSize="25" FontWeight="SemiBold"/><TextBlock Grid.Row="0" Text="Keep enabled managed clients alive without activating any window." Foreground="#929AAD" Margin="0,35,0,18"/><Border Grid.Row="1" Background="#11141B" BorderBrush="#272D3A" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14"><StackPanel Orientation="Horizontal"><TextBlock Text="Threshold" VerticalAlignment="Center" Foreground="#929AAD"/><TextBlock Text="17 minutes + jitter" Margin="12,0,0,0" VerticalAlignment="Center"/><Button Content="Enable selected" Click="Enable_Click" Margin="20,0,0,0" Background="#7C5CFC" Foreground="White" Padding="14,7"/><Button Content="Pause all" Click="Pause_Click" Margin="8,0,0,0" Background="#1D2230" Foreground="#F5F7FA" Padding="14,7"/></StackPanel></Border><Border Grid.Row="2" Background="#11141B" BorderBrush="#272D3A" BorderThickness="1" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="ACCOUNT HEALTH" Foreground="#929AAD" FontSize="11"/><ListBox x:Name="AccountList" Margin="0,10,0,0"><ListBoxItem Content="Waiting for managed account events from the launcher host."/></ListBox></StackPanel></Border><TextBlock Grid.Row="3" x:Name="StatusText" Text="Background-safe mode: no focus APIs are used." Foreground="#929AAD" Margin="0,14,0,0"/></Grid>
</Window>
